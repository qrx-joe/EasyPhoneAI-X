# EasyPhoneAI-X「安心下一步」环境变量样例
# 复制为 .env.local 并填入真实值。.env.local 已被 .gitignore 排除，不会被提交。
# 所有变量 SERVER-ONLY（无 NEXT_PUBLIC_ 前缀）—— API key 永远不离开服务器。

# ===== 百炼 Qwen Vision（第四阶段接入时核验）=====
# 方案 7.2 节：P0 默认接入百炼 Qwen Vision，但具体模型名、区域端点和价格
# 在实施时根据官方控制台重新核验。第一阶段只留占位，不填值。
#
# 阿里云百炼控制台：https://bailian.console.aliyun.com
# DASHSCOPE_API_KEY 从百炼控制台创建（API-KEY 管理），最小权限即可。
DASHSCOPE_API_KEY=

# 视觉模型名。第四阶段接入时依据百炼控制台「模型广场」实际可用型号填写，
# 例如 qwen-vl-max / qwen-vl-plus（具体以控制台为准，不要凭记忆写）。
QWEN_VISION_MODEL=

# 视觉请求硬超时（毫秒）。方案 7.2 节规定硬超时 5 秒，最多一次受控重试。
QWEN_VISION_TIMEOUT_MS=5000

# 视觉模型端点（OpenAI 兼容模式）。
# 来源：百炼官方文档 https://help.aliyun.com/zh/model-studio/qwen-vl-compatible-with-openai
# base_url 用于 OpenAI 兼容接口，adapter 内部拼接 /chat/completions。
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
